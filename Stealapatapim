}

local FONT = Enum.Font.Gotham
local BOLD = Enum.Font.GothamBold
local BLACK = Enum.Font.GothamBlack
local MONO = Enum.Font.Code

local function new(class, props, children)
	local obj = Instance.new(class)
	local parent = props.Parent
	props.Parent = nil
	for k, v in pairs(props) do obj[k] = v end
	if children then for _, c in ipairs(children) do c.Parent = obj end end
	obj.Parent = parent
	return obj
end

local function corner(obj, r)
	new("UICorner", { CornerRadius = UDim.new(0, r or 6), Parent = obj })
	return obj
end

local function round(obj)
	new("UICorner", { CornerRadius = UDim.new(1, 0), Parent = obj })
	return obj
end

local function strokeUI(obj, color, thickness)
	return new("UIStroke", { Color = color or T.LINE, Thickness = thickness or 1, Parent = obj })
end

local function text(props)
	props.BackgroundTransparency = props.BackgroundTransparency or 1
	props.BorderSizePixel = 0
	props.Font = props.Font or FONT
	props.TextSize = props.TextSize or 13
	props.TextColor3 = props.TextColor3 or T.TEXT
	props.TextXAlignment = props.TextXAlignment or Enum.TextXAlignment.Left
	props.TextYAlignment = props.TextYAlignment or Enum.TextYAlignment.Top
	return new("TextLabel", props)
end

local function fill(parent, color, size, pos)
	return new("Frame", {
		Size = size, Position = pos or UDim2.fromOffset(0, 0),
		BackgroundColor3 = color, BorderSizePixel = 0, Parent = parent,
	})
end

local function tween(obj, time, goal)
	local t = TweenService:Create(obj, TweenInfo.new(time, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), goal)
	t:Play()
	return t
end
