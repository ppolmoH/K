--#region CAMERA CONTROL SYSTEM
local function getTargetPartFromChar(char)
	if not char then return nil end
	local partName = CONFIG.TargetPart
	if partName == "Head" then return char:FindFirstChild("Head")
	elseif partName == "Body" then return char:FindFirstChild("HumanoidRootPart")
	elseif partName == "Torso" then return char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso") end
	return char:FindFirstChild("Head")
end

local function isEnemy(targetPlayer)
	if not CONFIG.TeamFilter then return true end
	local myTeam = player.Team
	local theirTeam = targetPlayer.Team
	if myTeam == nil and theirTeam == nil then return true end
	return myTeam ~= theirTeam
end

local function canSeeTarget(targetPart, targetChar)
	if not CONFIG.VisibilityCheck then return true end
	local myChar = player.Character
	if not myChar then return true end
	local myHead = myChar:FindFirstChild("Head")
	if not myHead then return true end
	local origin = myHead.Position
	local direction = (targetPart.Position - origin)
	local dist = direction.Magnitude
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { myChar, targetChar }
	local result = Workspace:Raycast(origin, direction.Unit * dist, params)
	if result then
		local hitDist = (result.Position - origin).Magnitude
		return hitDist >= dist - 1
	end
	return true
end

local function predictTargetPosition(targetPart, targetChar, distance)
	if not CONFIG.PredictionEnabled then return targetPart.Position end
	if distance < CONFIG.MinPredictDist then return targetPart.Position end
	local targetVel = targetPart.AssemblyLinearVelocity
	local velMagnitude = targetVel.Magnitude
	local movementFactor = CONFIG.MovementSmoothing
	if velMagnitude < 5 then movementFactor = 0 end
	local travelTime = distance / CONFIG.ProjectileSpeed
	local predictFactor = 1.0
	if distance < CONFIG.MidPredictDist then
		predictFactor = (distance - CONFIG.MinPredictDist) / (CONFIG.MidPredictDist - CONFIG.MinPredictDist)
	end
	local predicted = targetPart.Position + (targetVel * travelTime * predictFactor * movementFactor)
	if distance > CONFIG.MidPredictDist then
		local gravityDrop = 0.5 * CONFIG.Gravity * (travelTime * travelTime)
		predicted = predicted + Vector3.new(0, gravityDrop * predictFactor, 0)
	end
	return predicted
end

local function findBestTarget()
	local myRoot = getMyRoot()
	if not myRoot then return nil, nil, nil, nil end
	local vpSize = camera.ViewportSize
	local cx, cy = vpSize.X / 2, vpSize.Y / 2
	local candidates = {}
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= player and isEnemy(plr) then
			local char = plr.Character
			if char then
				local humanoid = char:FindFirstChild("Humanoid")
				if humanoid and humanoid.Health > 0 then
					local part = getTargetPartFromChar(char)
					if part then
						local screenPos, onScreen = camera:WorldToScreenPoint(part.Position)
						if onScreen then
							local sx, sy = screenPos.X, screenPos.Y
							local screenDist = math.sqrt((sx - cx) ^ 2 + (sy - cy) ^ 2)
							if screenDist <= CONFIG.LockOnRange then
								if canSeeTarget(part, char) then
									local hpPercent = (humanoid.Health / humanoid.MaxHealth) * 100
									local dist3D = (myRoot.Position - part.Position).Magnitude
									table.insert(candidates, {
										player = plr, part = part, char = char,
										screenDist = screenDist, hpPercent = hpPercent, distance = dist3D,
									})
								end
							end
						end
					end
				end
			end
		end
	end
	if #candidates == 0 then return nil, nil, nil, nil end
	if CONFIG.PriorityLowHP then
		table.sort(candidates, function(a, b)
			local aLow = a.hpPercent <= CONFIG.LowHPThreshold
			local bLow = b.hpPercent <= CONFIG.LowHPThreshold
			if aLow ~= bLow then return aLow end
			return a.screenDist < b.screenDist
		end)
	else
		table.sort(candidates, function(a, b) return a.screenDist < b.screenDist end)
	end
	local best = candidates[1]
	return best.player, best.part, best.screenDist, best.distance
end

local function calculateSmoothness(distance)
	if distance < 40 then return 0.9
	elseif distance < 100 then return 0.6
	else return 0.3 end
end
