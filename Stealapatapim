	local current = opt.Default or opt.Options[1]
	local btn = new("TextButton", {
		Parent = row, Text = current, Font = MONO, TextSize = 11,
		TextColor3 = T.ACCENT, AutoButtonColor = false,
		BackgroundColor3 = T.ACC_BG, BorderSizePixel = 0,
		AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 16),
		Size = UDim2.fromOffset(96, 30),
	})
	corner(btn, 5); strokeUI(btn, T.ACC_DK)
	local dropFrame = new("Frame", {
		Parent = row, BackgroundColor3 = T.CARD, BorderSizePixel = 0,
		AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 50),
		Size = UDim2.fromOffset(96, #opt.Options * 28), Visible = false, ZIndex = 10,
	})
	corner(dropFrame, 5); strokeUI(dropFrame, T.LINE)
	new("UIListLayout", { Parent = dropFrame, SortOrder = Enum.SortOrder.LayoutOrder })
	local open = false
	local function closeDrop() open = false; dropFrame.Visible = false end
	for i, option in ipairs(opt.Options) do
		local ob = new("TextButton", {
			Parent = dropFrame, Text = option, Font = MONO, TextSize = 11,
			TextColor3 = T.TEXT, AutoButtonColor = false,
			BackgroundColor3 = T.CARD, BackgroundTransparency = 0,
			BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 28), LayoutOrder = i, ZIndex = 11,
		})
		ob.MouseEnter:Connect(function() ob.BackgroundColor3 = T.ACC_BG end)
		ob.MouseLeave:Connect(function() ob.BackgroundColor3 = T.CARD end)
		ob.MouseButton1Click:Connect(function()
			current = option; btn.Text = option
			closeDrop()
			safe(function() opt.Callback(option) end)
		end)
	end
	btn.MouseButton1Click:Connect(function() open = not open; dropFrame.Visible = open end)
	return { Get = function() return current end }
end

local function Keybind(page, opt)
