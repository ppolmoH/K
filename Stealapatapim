--#region PAGE SYSTEM
local pages, navButtons, activePage = {}, {}, nil

local function selectPage(id)
	activePage = id
	for pid, page in pairs(pages) do
		if page.Frame and page.Frame.Parent then
			page.Frame.Visible = (pid == id)
		end
	end
	for pid, nav in pairs(navButtons) do
		local on = (pid == id)
		tween(nav.Button, 0.15, { BackgroundTransparency = on and 0 or 1 })
		tween(nav.Bar, 0.15, { BackgroundTransparency = on and 0 or 1 })
		nav.Num.TextColor3 = on and T.ACCENT or T.DIM
		nav.Name.TextColor3 = on and Color3.fromRGB(255, 255, 255) or T.MUTED
		nav.Name.Font = on and BOLD or FONT
	end
end

