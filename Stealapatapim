    local trajectoryFolder = Instance.new("Folder")
    trajectoryFolder.Name = "TrajectoryESP"
    trajectoryFolder.Parent = _Workspace
    local function clearTrajectory() trajectoryFolder:ClearAllChildren() end
    local function drawTrajectory()
        clearTrajectory()
        if not CONFIG.TrajectoryESP then return end
        local char = _plr.Character
        if not char then return end
        local hasTool = false
        for _, obj in ipairs(char:GetChildren()) do
            if obj:IsA("Tool") then hasTool = true; break end
        end
        if not hasTool then return end
        local rightHand = char:FindFirstChild("RightHand") or char:FindFirstChild("Right Arm")
        if not rightHand then return end
        local origin = rightHand.Position
        local direction = _camera.CFrame.LookVector
        local speed = CONFIG.ProjectileSpeed
        local gravity = CONFIG.Gravity
        local dt = 0.05
        local pos = origin
        local vel = direction * speed
        local lastPart = nil
        for t = 0, 2, dt do
            vel = vel + Vector3.new(0, -gravity * dt, 0)
            pos = pos + vel * dt
            local part = Instance.new("Part")
            part.Size = Vector3.new(0.2, 0.2, 0.2)
            part.Position = pos
            part.Anchored = true
            part.CanCollide = false
            part.Material = Enum.Material.Neon
            part.Color = Color3.fromRGB(255, 100, 100)
            part.Transparency = 0.3
            part.Parent = trajectoryFolder
            if lastPart then
                local beam = Instance.new("Beam")
                local att0 = Instance.new("Attachment", lastPart)
                local att1 = Instance.new("Attachment", part)
                beam.Attachment0 = att0; beam.Attachment1 = att1
                beam.Color = ColorSequence.new(Color3.fromRGB(255, 100, 100))
                beam.FaceCamera = true
                beam.Width0 = 0.15; beam.Width1 = 0.15
                beam.Transparency = NumberSequence.new(0.5)
                beam.Parent = part
            end
            lastPart = part
            local params = RaycastParams.new()
            params.FilterType = Enum.RaycastFilterType.Exclude
            params.FilterDescendantsInstances = { char, trajectoryFolder }
            local result = _Workspace:Raycast(pos - vel * dt, vel * dt, params)
            if result then break end
        end
    end

