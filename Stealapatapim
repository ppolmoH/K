--#region WIDGETS
local function nextOrder(p) p.Order += 1; return p.Order end

local function rowFrame(page, height)
	local f = new("Frame", { Parent = page.Frame, BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, height), LayoutOrder = nextOrder(page) })
	fill(f, T.LINE_S, UDim2.new(1, 0, 0, 1), UDim2.new(0, 0, 1, -1))
	return f
end

local function rowText(parent, title, desc)
	text({ Parent = parent, Text = title, Font = BOLD, TextSize = 14,
		Position = UDim2.fromOffset(0, 16), Size = UDim2.new(1, -90, 0, 18) })
	text({ Parent = parent, Text = desc, TextSize = 11, TextColor3 = T.MUTED, TextWrapped = true,
		RichText = true, Position = UDim2.fromOffset(0, 37), Size = UDim2.new(1, -110, 0, 32) })
end

local function Toggle(page, opt)
	local row = rowFrame(page, 78)
	rowText(row, opt.Title, opt.Desc)
	local btn = new("TextButton", {
		Parent = row, Text = "", AutoButtonColor = false,
		AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 18),
		Size = UDim2.fromOffset(46, 24), BackgroundColor3 = T.CARD, BorderSizePixel = 0,
	})
	round(btn)
	local st = strokeUI(btn, T.LINE)
	local knob = new("Frame", { Parent = btn, Size = UDim2.fromOffset(18, 18), Position = UDim2.fromOffset(3, 3),
		BackgroundColor3 = T.KNOB, BorderSizePixel = 0 })
	round(knob)
	local value = opt.Default or false
	local function render(instant)
		local d = instant and 0 or 0.16
		tween(knob, d, { Position = value and UDim2.fromOffset(25, 3) or UDim2.fromOffset(3, 3),
			BackgroundColor3 = value and T.ACCENT or T.KNOB })
		tween(btn, d, { BackgroundColor3 = value and T.ACC_BG or T.CARD })
		st.Color = value and T.ACC_DK or T.LINE
	end
	render(true)
	btn.MouseButton1Click:Connect(function()
		value = not value; render()
		safe(function() opt.Callback(value) end)
	end)
	return { Set = function(_, v) value = v; render(); safe(function() opt.Callback(v) end) end,
		Get = function() return value end }
end

local function Slider(page, opt)
	local row = rowFrame(page, 112)
	text({ Parent = row, Text = opt.Title, Font = BOLD, TextSize = 14,
		Position = UDim2.fromOffset(0, 18), Size = UDim2.new(1, -110, 0, 18) })
	local valueLabel = text({ Parent = row, Text = "", Font = MONO, TextSize = 16, TextColor3 = T.ACCENT,
		TextXAlignment = Enum.TextXAlignment.Right, AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 16), Size = UDim2.fromOffset(110, 20) })
	text({ Parent = row, Text = opt.Desc, TextSize = 11, TextColor3 = T.MUTED, TextWrapped = true,
		Position = UDim2.fromOffset(0, 38), Size = UDim2.new(1, -20, 0, 16) })
	local tr = new("TextButton", { Parent = row, Text = "", AutoButtonColor = false, BackgroundTransparency = 1,
		Position = UDim2.fromOffset(0, 62), Size = UDim2.new(1, 0, 0, 16) })
	fill(tr, Color3.fromRGB(34, 45, 36), UDim2.new(1, 0, 0, 2), UDim2.fromOffset(0, 7))
	local fillBar = fill(tr, T.ACCENT, UDim2.new(0, 0, 0, 2), UDim2.fromOffset(0, 7))
	local knob = new("Frame", { Parent = tr, Size = UDim2.fromOffset(13, 13), AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0, 0, 0, 8), BackgroundColor3 = T.ACCENT, BorderSizePixel = 0 })
	round(knob)
	local hole = new("Frame", { Parent = knob, Size = UDim2.fromOffset(5, 5), AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, 0), BackgroundColor3 = T.BG, BorderSizePixel = 0 })
	round(hole)
	text({ Parent = row, Text = opt.MinLabel, Font = MONO, TextSize = 9, TextColor3 = T.DIM,
		Position = UDim2.fromOffset(0, 84), Size = UDim2.fromOffset(120, 12) })
	text({ Parent = row, Text = opt.MaxLabel, Font = MONO, TextSize = 9, TextColor3 = T.DIM,
		TextXAlignment = Enum.TextXAlignment.Right, AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 84), Size = UDim2.fromOffset(120, 12) })
	local value = opt.Default
	local function render()
		local a = (value - opt.Min) / (opt.Max - opt.Min)
		fillBar.Size = UDim2.new(a, 0, 0, 2)
		knob.Position = UDim2.new(a, 0, 0, 8)
		valueLabel.Text = opt.Format(value)
	end
	local function setFromX(px)
		local abs = tr.AbsolutePosition.X
		local w = math.max(tr.AbsoluteSize.X, 1)
		local a = math.clamp((px - abs) / w, 0, 1)
		local raw = opt.Min + a * (opt.Max - opt.Min)
		value = math.clamp(math.floor(raw / opt.Step + 0.5) * opt.Step, opt.Min, opt.Max)
		render(); safe(function() opt.Callback(value) end)
	end
	local held = false
	tr.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			held = true; setFromX(input.Position.X)
			tween(knob, 0.1, { Size = UDim2.fromOffset(16, 16) })
		end
	end)
	track(UserInputService.InputChanged:Connect(function(input)
		if held and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			setFromX(input.Position.X)
		end
	end))
	track(UserInputService.InputEnded:Connect(function(input)
		if held and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
			held = false; tween(knob, 0.1, { Size = UDim2.fromOffset(13, 13) })
		end
	end))
	render()
	return { Set = function(_, v) value = v; render() end, Get = function() return value end }
end

local function Dropdown(page, opt)
