local fpsAcc, statsAcc = 0, 0

track(RunService.RenderStepped:Connect(function(dt)
	safe(function()
		if dt > 0 then STATS.FPS = math.floor(1 / dt + 0.5) end
		local myRoot = getMyRoot()

		-- Camera Track
		if CONFIG.CameraTrack and myRoot then
			local targetPlr, targetPart, screenDist, distance = findBestTarget()
			if targetPlr and targetPart and distance then
				local aimPos = predictTargetPosition(targetPart, targetPlr.Character, distance)
				local camPos = camera.CFrame.Position
				local currentLook = camera.CFrame.LookVector
				local targetLook = (aimPos - camPos).Unit
				local smoothness = calculateSmoothness(distance)
				local newLook = currentLook:Lerp(targetLook, smoothness)
				camera.CFrame = CFrame.lookAt(camPos, camPos + newLook * 100)
				targetNameLabel.Text = targetPlr.Name
				targetDistLabel.Text = math.floor(distance) .. "m away"
				local hum = targetPlr.Character and targetPlr.Character:FindFirstChild("Humanoid")
				if hum then
					local ratio = hum.Health / hum.MaxHealth
					targetHPLabel.Text = math.floor(ratio * 100) .. "% HP"
					targetHPLabel.TextColor3 = hpColor(ratio)
				end
			else
				targetNameLabel.Text = "—"
				targetDistLabel.Text = ""
				targetHPLabel.Text = ""
			end
		end

		-- Trajectory
		drawTrajectory()

		-- FPS display
		fpsAcc += dt
		if fpsAcc >= 0.1 then
			fpsAcc = 0
			fpsLabel.Text = tostring(STATS.FPS)
		end

		-- Stats
		statsAcc += dt
		if statsAcc >= 1 then
			statsAcc = 0
			local count = 0
			for _, data in pairs(overlayData) do
				if data.billboard and data.billboard.Parent and data.billboard.Enabled then count += 1 end
			end
			STATS.ActiveOverlays = count
			playerCountLabel.Text = tostring(count)
			oreCountLabel.Text = tostring(STATS.OresTracked)
		end

		updateOreESP()
		updateHandItemESP()
	end)
end))

