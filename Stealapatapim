local function applySpeed()
	local char = player.Character
	if not char then return end
	local humanoid = char:FindFirstChild("Humanoid")
	if not humanoid then return end

	if CONFIG.SpeedHackEnabled then
		if CONFIG.AntiDetectEnabled then
			local currentTime = tick()
			if currentTime - STATE.LastSpeedChange > CONFIG.DetectionDelay then
				humanoid.WalkSpeed = CONFIG.Speed
				STATE.LastSpeedChange = currentTime
			end
		else
			humanoid.WalkSpeed = CONFIG.Speed
		end
	else
		if humanoid.WalkSpeed ~= STATE.OriginalSpeed then
			humanoid.WalkSpeed = STATE.OriginalSpeed
		end
	end
end

local function applyJump()
	local char = player.Character
	if not char then return end
	local humanoid = char:FindFirstChild("Humanoid")
	if not humanoid then return end

	if CONFIG.JumpPowerEnabled then
		if humanoid.UseJumpPower then
			humanoid.JumpPower = CONFIG.JumpPower
		else
			humanoid.JumpHeight = CONFIG.JumpPower / 7.5
		end
	else
		if humanoid.UseJumpPower then
			humanoid.JumpPower = STATE.OriginalJump
		end
	end
end

