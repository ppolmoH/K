--#region HAND ITEM ESP MODULE
local function getHandItem(char)
	local result = nil
	safe(function()
		local rightArm = char:FindFirstChild("RightUpperArm")
		if not rightArm then return nil end
		for _, child in ipairs(rightArm:GetChildren()) do
			if child:IsA("Tool") or child:IsA("Model") or child:IsA("Part") then
				result = child.Name
				return
			end
		end
		for _, joint in ipairs(rightArm:GetChildren()) do
			if joint:IsA("Weld") or joint:IsA("Motor6D") then
				local part1 = joint.Part1
				if part1 and part1.Parent and part1.Parent ~= char then
					result = part1.Parent.Name
					return
				end
			end
		end
	end)
	return result
end

local function createHandItemESP(plr)
	if handItemESPData[plr] or plr == player then return end
	local char = plr.Character
	if not char then return end
	local root = char:FindFirstChild("HumanoidRootPart")
	if not root then return end

	local bb = Instance.new("BillboardGui")
	bb.Adornee = root
	bb.Size = UDim2.fromOffset(200, 30)
	bb.StudsOffset = Vector3.new(0, 4, 0)
	bb.AlwaysOnTop = true
	bb.Parent = root

	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, 0, 1, 0)
	label.BackgroundTransparency = 1
	label.Text = "Checking hand..."
	label.TextColor3 = Color3.fromRGB(100, 200, 255)
	label.Font = MONO
	label.TextSize = 12
	label.TextWrapped = true
	label.TextStrokeTransparency = 0.5
	label.Parent = bb

	handItemESPData[plr] = { billboard = bb, label = label }

	task.spawn(function()
		while CONFIG.HandItemESP and handItemESPData[plr] do
			local itemName = getHandItem(char)
			label.Text = itemName and ("✋ " .. itemName) or "✋ Empty"
			task.wait(0.5)
		end
	end)
end

local function updateHandItemESP()
	if not CONFIG.HandItemESP then
		for plr, data in pairs(handItemESPData) do
			safe(function()
				if data.billboard then data.billboard:Destroy() end
			end)
		end
		handItemESPData = {}
		return
	end
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= player and not handItemESPData[plr] then
			createHandItemESP(plr)
		end
	end
end
