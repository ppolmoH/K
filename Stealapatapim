local function notify(title, body, dur)
	safe(function()
		local card = new("Frame", {
			Parent = toastHolder, BackgroundColor3 = T.CARD, BorderSizePixel = 0,
			Size = UDim2.new(1, 0, 0, 52), BackgroundTransparency = 1,
		})
		corner(card, 6)
		local st = strokeUI(card, T.ACC_DK); st.Transparency = 1
		fill(card, T.ACCENT, UDim2.new(0, 2, 1, 0))
		local a = text({ Parent = card, Text = title, Font = MONO, TextSize = 10, TextColor3 = T.ACCENT,
			Position = UDim2.fromOffset(14, 11), Size = UDim2.new(1, -20, 0, 12), TextTransparency = 1 })
		local b = text({ Parent = card, Text = body, TextSize = 12, TextColor3 = T.TEXT, TextWrapped = true,
			Position = UDim2.fromOffset(14, 26), Size = UDim2.new(1, -24, 0, 18), TextTransparency = 1 })
		tween(card, 0.14, { BackgroundTransparency = 0 })
		tween(a, 0.14, { TextTransparency = 0 })
		tween(b, 0.14, { TextTransparency = 0 })
		st.Transparency = 0
		task.delay(dur or 2, function()
			tween(card, 0.18, { BackgroundTransparency = 1 })
			tween(a, 0.18, { TextTransparency = 1 })
			tween(b, 0.18, { TextTransparency = 1 })
			task.wait(0.22); safe(function() card:Destroy() end)
		end)
	end)
end
