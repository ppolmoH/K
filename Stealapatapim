-- FREE CAM
-- ═══════════════════════════════════════════════════════════════
local FreeCam = {
    Enabled = false, Speed = 100, Sensitivity = 0.25,
    CamPos = nil, Yaw = 0, Pitch = 0, MoveConn = nil, MouseConn = nil,
}
function FreeCam:Enable()
    if self.Enabled then return end
    self.Enabled = true
    local c = Workspace.CurrentCamera
    if not c then self.Enabled = false; return end
    camera = c
    self.CamPos = c.CFrame.Position
    local look = c.CFrame.LookVector
    self.Yaw = math.deg(math.atan2(-look.X, -look.Z))
    self.Pitch = math.deg(math.asin(math.clamp(look.Y, -1, 1)))
    c.CameraType = Enum.CameraType.Scriptable
    if _G.CZC_COMBAT and _G.CZC_COMBAT.disableCameraTrack then
        pcall(_G.CZC_COMBAT.disableCameraTrack)
    end
    UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
    self.MouseConn = UserInputService.InputChanged:Connect(function(input)
        if not self.Enabled then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement then
            local d = input.Delta
            self.Yaw = self.Yaw - d.X * self.Sensitivity
            self.Pitch = math.clamp(self.Pitch - d.Y * self.Sensitivity, -89, 89)
        end
    end)
    self.MoveConn = RunService.RenderStepped:Connect(function(dt)
        if not self.Enabled then return end
        local cam = Workspace.CurrentCamera
        if not cam then return end
        local rot = CFrame.fromEulerAnglesYXZ(math.rad(self.Pitch), math.rad(self.Yaw), 0)
        local mv = Vector3.new(0, 0, 0)
        local sp = self.Speed
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then sp = sp * 3 end
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then mv = mv + rot.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then mv = mv - rot.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then mv = mv - rot.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then mv = mv + rot.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then mv = mv + Vector3.new(0, 1, 0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then mv = mv - Vector3.new(0, 1, 0) end
        if mv.Magnitude > 0 then self.CamPos = self.CamPos + mv.Unit * sp * dt end
        cam.CFrame = CFrame.new(self.CamPos) * rot
    end)
    sharedNotify("FREE CAM", "ON · WASD+Space/Ctrl · Shift=Boost · V=Off", 2.5)
end
function FreeCam:Disable()
    if not self.Enabled then return end
    self.Enabled = false
    if self.MoveConn then self.MoveConn:Disconnect(); self.MoveConn = nil end
    if self.MouseConn then self.MouseConn:Disconnect(); self.MouseConn = nil end
    UserInputService.MouseBehavior = Enum.MouseBehavior.Default
    local c = Workspace.CurrentCamera
    if c then c.CameraType = Enum.CameraType.Custom end
    sharedNotify("FREE CAM", "OFF", 1.5)
end
function FreeCam:Toggle()
    if self.Enabled then self:Disable() else self:Enable() end
end

