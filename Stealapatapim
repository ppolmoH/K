    local function getAllBodyParts(character)
        local parts = {}
        if not character then return parts end
        for _, child in ipairs(character:GetChildren()) do
            if child:IsA("BasePart") then
                local parent = child.Parent
                local isAcc = parent and (parent:IsA("Accessory") or parent:IsA("Hat"))
                if not isAcc then table.insert(parts, child) end
            end
        end
        return parts
    end

    local function applySizeOverrideToPart(part)
        if not part then return end
        if not originalProperties[part] then
            originalProperties[part] = {
                Size = part.Size, CanQuery = part.CanQuery, CanTouch = part.CanTouch,
                Transparency = part.Transparency, Material = part.Material, Massless = part.Massless,
            }
            targetSizes[part] = calculateNewSize(part.Size, part.Name)
        end
        local tSize = targetSizes[part]
        if tSize then part.Size = tSize end
        if part.CanQuery == false then part.CanQuery = true end
        if part.CanTouch == false then part.CanTouch = true end
        if transparentZonesEnabled then part.Transparency = 0.7
        else part.Transparency = math.min(part.Transparency, 0.5) end
    end

    local function restoreSizeOverridePart(part)
        local props = originalProperties[part]
        if not props then return end
        if part and part.Parent then
            part.Size = props.Size
            part.CanQuery = props.CanQuery
            part.CanTouch = props.CanTouch
            part.Transparency = props.Transparency
            part.Material = props.Material
            part.Massless = props.Massless
        end
        originalProperties[part] = nil
        targetSizes[part] = nil
    end

    local function createOverlapForPart(character, targetPart)
        if not character or not targetPart then return nil end
        if not originalProperties[targetPart] then
            originalProperties[targetPart] = {
                Size = targetPart.Size, CanQuery = targetPart.CanQuery,
                CanTouch = targetPart.CanTouch, Transparency = targetPart.Transparency,
                Material = targetPart.Material, Massless = targetPart.Massless,
            }
            targetSizes[targetPart] = calculateNewSize(targetPart.Size, targetPart.Name)
        end
        local tSize = targetSizes[targetPart] or targetPart.Size
        local overlapPart = Instance.new("Part")
        overlapPart.Name = targetPart.Name
        overlapPart.Size = tSize
        overlapPart.CFrame = targetPart.CFrame
        overlapPart.Transparency = 1
        overlapPart.CanCollide = false
        overlapPart.CanQuery = true
        overlapPart.CanTouch = true
        overlapPart.Anchored = true
        overlapPart.Massless = true
        overlapPart.Material = Enum.Material.ForceField
        overlapPart.Color = COLORS.highlightFill
        overlapPart.Parent = character
        overlapPart:SetAttribute("CZC_Overlap", true)
        return overlapPart
    end

    function removeOverlapZones()
        for origPart, overlapPart in pairs(overlapPartMap) do
            if overlapPart and overlapPart.Parent then overlapPart:Destroy() end
        end
        table.clear(overlapPartMap)
        table.clear(createdOverlapZones)
    end

    local function removeOverlapForCharacter(character)
        if not character then return end
        local toRemove = {}
        for origPart, overlapPart in pairs(overlapPartMap) do
            if origPart.Parent == character or (overlapPart and overlapPart.Parent == character) then
                if overlapPart and overlapPart.Parent then overlapPart:Destroy() end
                table.insert(toRemove, origPart)
            end
        end
        for _, key in ipairs(toRemove) do
            overlapPartMap[key] = nil
            createdOverlapZones[key] = nil
        end
    end

    local function calibratePlayer(targetPlayer)
        if targetPlayer == _plr then return end
        local character = targetPlayer.Character
        if not character then return end
        local bodyParts = getAllBodyParts(character)
        local useSize = (detectionMethod == "SizeOverride" or detectionMethod == "Both")
        local useOverlap = (detectionMethod == "OverlapPart" or detectionMethod == "Both")
        for _, part in ipairs(bodyParts) do
            if useSize then applySizeOverrideToPart(part) end
            if useOverlap then
                if not overlapPartMap[part] or not overlapPartMap[part].Parent then
                    local overlapPart = createOverlapForPart(character, part)
                    if overlapPart then
                        overlapPartMap[part] = overlapPart
                        createdOverlapZones[overlapPart] = true
                    end
                end
            end
        end
        if visualOutlineEnabled then
            local hasHighlight = false
            for part, _ in pairs(highlightInstances) do
                if part.Parent == character then hasHighlight = true break end
            end
            if not hasHighlight and #bodyParts > 0 then
                local hl = Instance.new("Highlight")
                hl.Name = "CZC_HL"
                hl.FillColor = COLORS.highlightFill
                hl.FillTransparency = 0.5
                hl.OutlineColor = COLORS.highlightFill
                hl.OutlineTransparency = 0.3
                hl.Adornee = character
                hl.Parent = character
                highlightInstances[bodyParts[1]] = hl
            end
        end
    end

    function calibrateZones()
        for _, targetPlayer in ipairs(_Players:GetPlayers()) do
            if targetPlayer ~= _plr then calibratePlayer(targetPlayer) end
        end
    end

    function restoreZones()
        local partsToRestore = {}
        for part, _ in pairs(originalProperties) do table.insert(partsToRestore, part) end
        for _, part in ipairs(partsToRestore) do restoreSizeOverridePart(part) end
        removeOverlapZones()
        for part, hl in pairs(highlightInstances) do
            if typeof(hl) == "Instance" and hl.Parent then hl:Destroy() end
        end
        table.clear(highlightInstances)
    end

    function restoreZonesForCharacter(character)
        if not character then return end
        local toRestore = {}
        for part, _ in pairs(originalProperties) do
            if part.Parent == character then table.insert(toRestore, part) end
        end
        for _, part in ipairs(toRestore) do restoreSizeOverridePart(part) end
        local hlToRemove = {}
        for part, hl in pairs(highlightInstances) do
            if part.Parent == character then
                if typeof(hl) == "Instance" and hl.Parent then hl:Destroy() end
                table.insert(hlToRemove, part)
            end
        end
        for _, key in ipairs(hlToRemove) do highlightInstances[key] = nil end
        removeOverlapForCharacter(character)
    end

    trackConnection(_RunService.PreSimulation:Connect(function()
        if not calibratorEnabled then return end
        for origPart, overlapPart in pairs(overlapPartMap) do
            if origPart and origPart.Parent and overlapPart and overlapPart.Parent then
                overlapPart.CFrame = origPart.CFrame
            end
        end
    end))

    task.spawn(function()
        while scriptActive do
            if calibratorEnabled then
                pcall(function()
                    if detectionMethod == "SizeOverride" or detectionMethod == "Both" then
                        for part, props in pairs(originalProperties) do
                            if part and part.Parent then
                                if part.CanQuery == false then part.CanQuery = true end
                                if part.CanTouch == false then part.CanTouch = true end
                                local tSize = targetSizes[part]
                                if tSize and (part.Size ~= tSize) then part.Size = tSize end
                                if part.Transparency > 0.9 and not transparentZonesEnabled then part.Transparency = 0.5 end
                            end
                        end
                    end
                    if detectionMethod == "OverlapPart" or detectionMethod == "Both" then
                        for origPart, overlapPart in pairs(overlapPartMap) do
                            if origPart and origPart.Parent and overlapPart and overlapPart.Parent then
                                if overlapPart.CanQuery == false then overlapPart.CanQuery = true end
                                if overlapPart.CanTouch == false then overlapPart.CanTouch = true end
                                local tSize = targetSizes[origPart]
                                if tSize and (overlapPart.Size ~= tSize) then overlapPart.Size = tSize end
                            end
                        end
                    end
                end)
            end
            task.wait(0.1)
        end
    end)

    task.spawn(function()
        while scriptActive do
            if calibratorEnabled then
                pcall(function()
                    for part, _ in pairs(originalProperties) do
                        if not part or not part.Parent then
                            originalProperties[part] = nil
                            targetSizes[part] = nil
                            if highlightInstances[part] then
                                if highlightInstances[part].Parent then highlightInstances[part]:Destroy() end
                                highlightInstances[part] = nil
                            end
                        end
                    end
                    for origPart, overlapPart in pairs(overlapPartMap) do
                        if not origPart or not origPart.Parent or not overlapPart or not overlapPart.Parent then
                            if overlapPart and overlapPart.Parent then overlapPart:Destroy() end
                            overlapPartMap[origPart] = nil
                            createdOverlapZones[overlapPart] = nil
                        end
                    end
                end)
            end
            task.wait(2.0)
        end
    end)

    local function setupPlayerTracking(targetPlayer)
        if targetPlayer == _plr then return end
        playerConnections[targetPlayer] = playerConnections[targetPlayer] or {}
        local charAddedConn = targetPlayer.CharacterAdded:Connect(function(character)
            if autoRestoreOnDeath and calibratorEnabled then
                task.spawn(function()
                    task.wait(1)
                    if calibratorEnabled and scriptActive then calibratePlayer(targetPlayer) end
                end)
            end
        end)
        table.insert(playerConnections[targetPlayer], charAddedConn)
        local charRemovingConn = targetPlayer.CharacterRemoving:Connect(function(character)
            if autoRestoreOnDeath then restoreZonesForCharacter(character) end
        end)
        table.insert(playerConnections[targetPlayer], charRemovingConn)
    end

    for _, targetPlayer in ipairs(_Players:GetPlayers()) do
        setupPlayerTracking(targetPlayer)
    end
    trackConnection(_Players.PlayerAdded:Connect(function(targetPlayer)
        setupPlayerTracking(targetPlayer)
        if calibratorEnabled then
            task.spawn(function()
                task.wait(1.5)
                if calibratorEnabled and scriptActive then calibratePlayer(targetPlayer) end
            end)
        end
    end))
    trackConnection(_Players.PlayerRemoving:Connect(function(targetPlayer)
        if targetPlayer.Character then restoreZonesForCharacter(targetPlayer.Character) end
        if playerConnections[targetPlayer] then
            for _, conn in ipairs(playerConnections[targetPlayer]) do pcall(function() conn:Disconnect() end) end
            playerConnections[targetPlayer] = nil
        end
    end))

    trackConnection(_RunService.RenderStepped:Connect(function(deltaTime)
        if not scriptActive then return end
        fpsValue = math.floor(1 / deltaTime)
    end))

    task.spawn(function()
        while scriptActive do
            pcall(function()
                local sizeCount = 0
                for _ in pairs(originalProperties) do sizeCount = sizeCount + 1 end
                statSizeLabel.Text = tostring(sizeCount)
                local overlapCount = 0
                for _, op in pairs(overlapPartMap) do if op and op.Parent then overlapCount = overlapCount + 1 end end
                statOverlapLabel.Text = tostring(overlapCount)
                statTotalLabel.Text = tostring(sizeCount + overlapCount)
                statFPSLabel.Text = tostring(fpsValue)
                local pCount = 0
                for _ in pairs(playerConnections) do pCount = pCount + 1 end
                statPlayersLabel.Text = tostring(pCount)
            end)
            task.wait(0.5)
        end
    end)

    trackConnection(_UIS.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed or not scriptActive or not debugRayEnabled then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            pcall(function()
                local cam = _Workspace.CurrentCamera
                if not cam then return end
                local mousePos = _UIS:GetMouseLocation()
                local mouseRay = cam:ViewportPointToRay(mousePos.X, mousePos.Y)
                local myChar = _plr.Character
                local rayParams = RaycastParams.new()
                rayParams.FilterType = Enum.RaycastFilterType.Exclude
                if myChar then rayParams.FilterDescendantsInstances = {myChar} end
                rayParams.IgnoreWater = true
                local rayResult = _Workspace:Raycast(mouseRay.Origin, mouseRay.Direction * 1000, rayParams)
                if rayResult and rayResult.Instance then
                    local hitPart = rayResult.Instance
                    local hitPos = rayResult.Position
                    local isOverlap = hitPart:GetAttribute("CZC_Overlap") == true
                    local isExpanded = originalProperties[hitPart] ~= nil or isOverlap
                    if isOverlap then notify("✓ OVERLAP HIT: " .. hitPart.Name, 1.5)
                    elseif isExpanded then notify("✓ EXPANDED HIT: " .. hitPart.Name, 1.5)
                    else notify("HIT: " .. hitPart.Name, 1.5) end
                    task.spawn(function()
                        local marker = Instance.new("Part")
                        marker.Size = Vector3.new(0.3, 0.3, 0.3)
                        marker.Shape = Enum.PartType.Ball
                        marker.Position = hitPos
                        marker.Anchored = true
                        marker.CanCollide = false
                        marker.CanQuery = false
                        marker.CanTouch = false
                        marker.Material = Enum.Material.Neon
                        marker.Color = isExpanded and COLORS.debugHit or COLORS.debugMiss
                        marker.Transparency = 0.3
                        marker.Parent = _Workspace
                        task.wait(0.8)
                        _Tween:Create(marker, TweenInfo.new(0.2), {Transparency = 1, Size = Vector3.new(0.05, 0.05, 0.05)}):Play()
                        task.wait(0.25)
                        marker:Destroy()
                    end)
                end
            end)
        end
    end))

    trackConnection(_UIS.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed or not scriptActive then return end
        if _G.CZC_COMBAT and _G.CZC_COMBAT.isListening and _G.CZC_COMBAT.isListening() then return end
        if hotkeyListening then
            if input.UserInputType == Enum.UserInputType.Keyboard then
                calibratorHotkey = input.KeyCode
                pcall(function()
                    hotkeyButton.Text = input.KeyCode.Name
                    _Tween:Create(hotkeyButton, TweenInfo.new(0.2), {BackgroundColor3 = COLORS.accent}):Play()
                end)
                hotkeyListening = false
                notify("Hotkey: " .. input.KeyCode.Name, 2)
                return
            end
        end
        if input.KeyCode == toggleHotkey then
            guiVisible = not guiVisible
            pcall(function()
                local ti = TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
                if guiVisible then
                    mainFrame.Visible = true
                    _Tween:Create(mainFrame, ti, {BackgroundTransparency = 0}):Play()
                    _Tween:Create(mainStroke, ti, {Transparency = 0.3}):Play()
                    _Tween:Create(shadowFrame, ti, {ImageTransparency = 0.5}):Play()
                else
                    _Tween:Create(mainFrame, ti, {BackgroundTransparency = 1}):Play()
                    _Tween:Create(mainStroke, ti, {Transparency = 1}):Play()
                    _Tween:Create(shadowFrame, ti, {ImageTransparency = 1}):Play()
                    task.delay(0.35, function()
                        if not guiVisible then mainFrame.Visible = false end
                    end)
                end
            end)
            return
        end
        if input.KeyCode == calibratorHotkey then
            calibratorEnabled = not calibratorEnabled
            zoneToggle.setValue(calibratorEnabled)
            if calibratorEnabled then
                safeCall(calibrateZones)
                notify("Calibration ON", 2)
            else
                safeCall(restoreZones)
                notify("Calibration OFF", 2)
            end
            return
        end
    end))

    rebuildSizeCache()
    notify("CZC v3.3 Loaded — Safe Rig Mode Active", 4)

    return {
        Notify = notify,
        IsCalibratorEnabled = function() return calibratorEnabled end,
    }
end)()

