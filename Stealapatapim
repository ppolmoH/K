    local function getTargetPartFromChar(char)
        if not char then return nil end
        local partName = CONFIG.TargetPart
        if partName == "Head" then return char:FindFirstChild("Head")
        elseif partName == "Body" then return char:FindFirstChild("HumanoidRootPart")
        elseif partName == "Torso" then return char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso") end
        return char:FindFirstChild("Head")
    end
    local function isEnemy(target)
        if not CONFIG.TeamFilter then return true end
        local myTeam = _plr.Team
        local theirTeam = target.Team
        if myTeam == nil and theirTeam == nil then return true end
        return myTeam ~= theirTeam
    end
    local function canSeeTarget(targetPart, targetChar)
        if not CONFIG.VisibilityCheck then return true end
        local myChar = _plr.Character
        if not myChar then return true end
        local myHead = myChar:FindFirstChild("Head")
        if not myHead then return true end
        local origin = myHead.Position
        local direction = (targetPart.Position - origin)
        local dist = direction.Magnitude
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = { myChar, targetChar }
        local result = _Workspace:Raycast(origin, direction.Unit * dist, params)
        if result then
            local hitDist = (result.Position - origin).Magnitude
            return hitDist >= dist - 1
        end
        return true
    end
    local function predictTargetPosition(targetPart, targetChar, distance)
        if not CONFIG.PredictionEnabled then return targetPart.Position end
        if distance < CONFIG.MinPredictDist then return targetPart.Position end
        local targetVel = targetPart.AssemblyLinearVelocity
        local velMagnitude = targetVel.Magnitude
        local movementFactor = CONFIG.MovementSmoothing
        if velMagnitude < 5 then movementFactor = 0 end
        local travelTime = distance / CONFIG.ProjectileSpeed
        local predictFactor = 1.0
        if distance < CONFIG.MidPredictDist then
            predictFactor = (distance - CONFIG.MinPredictDist) / (CONFIG.MidPredictDist - CONFIG.MinPredictDist)
        end
        local predicted = targetPart.Position + (targetVel * travelTime * predictFactor * movementFactor)
        if distance > CONFIG.MidPredictDist then
            local gravityDrop = 0.5 * CONFIG.Gravity * (travelTime * travelTime)
            predicted = predicted + Vector3.new(0, gravityDrop * predictFactor, 0)
        end
        return predicted
    end
    local function findBestTarget()
        local myRoot = getMyRoot()
        if not myRoot then return nil, nil, nil, nil end
        local vpSize = _camera.ViewportSize
        local cx, cy = vpSize.X / 2, vpSize.Y / 2
        local candidates = {}
        for _, target in ipairs(_Players:GetPlayers()) do
            if target ~= _plr and isEnemy(target) then
                local char = target.Character
                if char then
                    local humanoid = char:FindFirstChild("Humanoid")
                    if humanoid and humanoid.Health > 0 then
                        local part = getTargetPartFromChar(char)
                        if part then
                            local screenPos, onScreen = _camera:WorldToScreenPoint(part.Position)
                            if onScreen then
                                local sx, sy = screenPos.X, screenPos.Y
                                local screenDist = math.sqrt((sx - cx) ^ 2 + (sy - cy) ^ 2)
                                if screenDist <= CONFIG.LockOnRange then
                                    if canSeeTarget(part, char) then
                                        local hpPercent = (humanoid.Health / humanoid.MaxHealth) * 100
                                        local dist3D = (myRoot.Position - part.Position).Magnitude
                                        table.insert(candidates, {
                                            player = target, part = part, char = char,
                                            screenDist = screenDist, hpPercent = hpPercent, distance = dist3D,
                                        })
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
        if #candidates == 0 then return nil, nil, nil, nil end
        if CONFIG.PriorityLowHP then
            table.sort(candidates, function(a, b)
                local aLow = a.hpPercent <= CONFIG.LowHPThreshold
                local bLow = b.hpPercent <= CONFIG.LowHPThreshold
                if aLow ~= bLow then return aLow end
                return a.screenDist < b.screenDist
            end)
        else
            table.sort(candidates, function(a, b) return a.screenDist < b.screenDist end)
        end
        local best = candidates[1]
        return best.player, best.part, best.screenDist, best.distance
    end
    local function calculateSmoothness(distance)
        if distance < 40 then return 0.9
        elseif distance < 100 then return 0.6
        else return 0.3 end
    end

    local oreColors = {
        Stone = Color3.fromRGB(150, 150, 150),
        Metal = Color3.fromRGB(180, 180, 200),
        Sulfur = Color3.fromRGB(255, 255, 100),
    }
    local function getOreTypeFromModel(model)
        local oreAttr = model:GetAttribute("Ore")
        if oreAttr then
            local lower = string.lower(tostring(oreAttr))
            if lower:find("stone") then return "Stone"
            elseif lower:find("metal") then return "Metal"
            elseif lower:find("sulfur") then return "Sulfur" end
        end
        for _, child in ipairs(model:GetDescendants()) do
            local childOre = child:GetAttribute("Ore")
            if childOre then
                local lower = string.lower(tostring(childOre))
                if lower:find("stone") then return "Stone"
                elseif lower:find("metal") then return "Metal"
                elseif lower:find("sulfur") then return "Sulfur" end
            end
        end
        local lower = model.Name:lower()
        if lower:find("stone") then return "Stone"
        elseif lower:find("metal") then return "Metal"
        elseif lower:find("sulfur") then return "Sulfur" end
        return nil
    end
    local function createOreESP(ore)
        if oreESPData[ore] then return end
        local oreType = getOreTypeFromModel(ore)
        if not oreType then return end
        if oreType == "Stone" and not CONFIG.StoneESP then return end
        if oreType == "Metal" and not CONFIG.MetalESP then return end
        if oreType == "Sulfur" and not CONFIG.SulfurESP then return end
        local primary = ore.PrimaryPart or ore:FindFirstChildWhichIsA("BasePart")
        if not primary then return end
        local bb = Instance.new("BillboardGui")
        bb.Adornee = primary
        bb.Size = UDim2.fromOffset(100, 40)
        bb.StudsOffset = Vector3.new(0, 3, 0)
        bb.AlwaysOnTop = true
        bb.Parent = primary
        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(1, 0, 1, 0)
        label.BackgroundTransparency = 1
        label.Text = oreType
        label.TextColor3 = oreColors[oreType]
        label.Font = BOLD
        label.TextSize = 14
        label.TextStrokeTransparency = 0.5
        label.Parent = bb
        local hl = Instance.new("Highlight")
        hl.FillColor = oreColors[oreType]
        hl.OutlineColor = Color3.fromRGB(255, 255, 255)
        hl.FillTransparency = 0.6
        hl.OutlineTransparency = 0
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.Adornee = ore
        hl.Parent = ore
        oreESPData[ore] = { billboard = bb, highlight = hl, type = oreType }
    end
    local function updateOreESP()
        if not CONFIG.OreESP then
            for ore, data in pairs(oreESPData) do
                safe(function()
                    if data.billboard then data.billboard:Destroy() end
                    if data.highlight then data.highlight:Destroy() end
                end)
            end
            oreESPData = {}
            return
        end
        local oreSpawns = _Workspace:FindFirstChild("OreSpawns")
        if not oreSpawns then return end
        local myRoot = getMyRoot()
        if not myRoot then return end
        for _, ore in ipairs(oreSpawns:GetChildren()) do
            if ore:IsA("Model") then
                local oreType = getOreTypeFromModel(ore)
                if oreType then
                    local primary = ore.PrimaryPart or ore:FindFirstChildWhichIsA("BasePart")
                    if primary then
                        local distance = (myRoot.Position - primary.Position).Magnitude
                        if distance <= CONFIG.OreDistance then
                            if not oreESPData[ore] then createOreESP(ore) end
                            if oreESPData[ore] then
                                local show = false
                                if oreType == "Stone" and CONFIG.StoneESP then show = true end
                                if oreType == "Metal" and CONFIG.MetalESP then show = true end
                                if oreType == "Sulfur" and CONFIG.SulfurESP then show = true end
                                if oreESPData[ore].billboard then oreESPData[ore].billboard.Enabled = show end
                                if oreESPData[ore].highlight then oreESPData[ore].highlight.Enabled = show end
                            end
                        else
                            if oreESPData[ore] then
                                safe(function()
                                    if oreESPData[ore].billboard then oreESPData[ore].billboard:Destroy() end
                                    if oreESPData[ore].highlight then oreESPData[ore].highlight:Destroy() end
                                end)
                                oreESPData[ore] = nil
                            end
                        end
                    end
                end
            end
        end
        STATS.OresTracked = 0
        for _ in pairs(oreESPData) do STATS.OresTracked += 1 end
    end

    local function getHandItem(char)
        local result = nil
        safe(function()
            local rightArm = char:FindFirstChild("RightUpperArm")
            if not rightArm then return nil end
            for _, child in ipairs(rightArm:GetChildren()) do
                if child:IsA("Tool") or child:IsA("Model") or child:IsA("Part") then
                    result = child.Name
                    return
                end
            end
            for _, joint in ipairs(rightArm:GetChildren()) do
                if joint:IsA("Weld") or joint:IsA("Motor6D") then
                    local part1 = joint.Part1
                    if part1 and part1.Parent and part1.Parent ~= char then
                        result = part1.Parent.Name
                        return
                    end
                end
            end
        end)
        return result
    end
