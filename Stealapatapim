--#region ORE ESP MODULE
local oreColors = {
	Stone  = Color3.fromRGB(150, 150, 150),
	Metal  = Color3.fromRGB(180, 180, 200),
	Sulfur = Color3.fromRGB(255, 255, 100),
}

local function getOreTypeFromModel(model)
	local oreAttr = model:GetAttribute("Ore")
	if oreAttr then
		local lower = string.lower(tostring(oreAttr))
		if lower:find("stone") then return "Stone"
		elseif lower:find("metal") then return "Metal"
		elseif lower:find("sulfur") then return "Sulfur" end
	end
	for _, child in ipairs(model:GetDescendants()) do
		local childOre = child:GetAttribute("Ore")
		if childOre then
			local lower = string.lower(tostring(childOre))
			if lower:find("stone") then return "Stone"
			elseif lower:find("metal") then return "Metal"
			elseif lower:find("sulfur") then return "Sulfur" end
		end
	end
	local lower = model.Name:lower()
	if lower:find("stone") then return "Stone"
	elseif lower:find("metal") then return "Metal"
	elseif lower:find("sulfur") then return "Sulfur" end
	return nil
end

local function createOreESP(ore)
	if oreESPData[ore] then return end
	local oreType = getOreTypeFromModel(ore)
	if not oreType then return end
	if oreType == "Stone" and not CONFIG.StoneESP then return end
	if oreType == "Metal" and not CONFIG.MetalESP then return end
	if oreType == "Sulfur" and not CONFIG.SulfurESP then return end

	local primary = ore.PrimaryPart or ore:FindFirstChildWhichIsA("BasePart")
	if not primary then return end

	local bb = Instance.new("BillboardGui")
	bb.Adornee = primary
	bb.Size = UDim2.fromOffset(100, 40)
	bb.StudsOffset = Vector3.new(0, 3, 0)
	bb.AlwaysOnTop = true
	bb.Parent = primary

	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, 0, 1, 0)
	label.BackgroundTransparency = 1
	label.Text = oreType
	label.TextColor3 = oreColors[oreType]
	label.Font = BOLD
	label.TextSize = 14
	label.TextStrokeTransparency = 0.5
	label.Parent = bb

	local hl = Instance.new("Highlight")
	hl.FillColor = oreColors[oreType]
	hl.OutlineColor = Color3.fromRGB(255, 255, 255)
	hl.FillTransparency = 0.6
	hl.OutlineTransparency = 0
	hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	hl.Adornee = ore
	hl.Parent = ore

	oreESPData[ore] = { billboard = bb, highlight = hl, type = oreType }
end

local function updateOreESP()
	if not CONFIG.OreESP then
		for ore, data in pairs(oreESPData) do
			safe(function()
				if data.billboard then data.billboard:Destroy() end
				if data.highlight then data.highlight:Destroy() end
			end)
		end
		oreESPData = {}
		return
	end

	local oreSpawns = Workspace:FindFirstChild("OreSpawns")
	if not oreSpawns then return end
	local myRoot = getMyRoot()
	if not myRoot then return end

	for _, ore in ipairs(oreSpawns:GetChildren()) do
		if ore:IsA("Model") then
			local oreType = getOreTypeFromModel(ore)
			if oreType then
				local primary = ore.PrimaryPart or ore:FindFirstChildWhichIsA("BasePart")
				if primary then
					local distance = (myRoot.Position - primary.Position).Magnitude
					if distance <= CONFIG.OreDistance then
						if not oreESPData[ore] then createOreESP(ore) end
						if oreESPData[ore] then
							local show = false
							if oreType == "Stone" and CONFIG.StoneESP then show = true end
							if oreType == "Metal" and CONFIG.MetalESP then show = true end
							if oreType == "Sulfur" and CONFIG.SulfurESP then show = true end
							if oreESPData[ore].billboard then oreESPData[ore].billboard.Enabled = show end
							if oreESPData[ore].highlight then oreESPData[ore].highlight.Enabled = show end
						end
					else
						if oreESPData[ore] then
							safe(function()
								if oreESPData[ore].billboard then oreESPData[ore].billboard:Destroy() end
								if oreESPData[ore].highlight then oreESPData[ore].highlight:Destroy() end
							end)
							oreESPData[ore] = nil
						end
					end
				end
			end
		end
	end

	STATS.OresTracked = 0
	for _ in pairs(oreESPData) do STATS.OresTracked += 1 end
end
