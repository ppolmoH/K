        valLabel.Font = Enum.Font.GothamBold
        valLabel.TextSize = 13
        valLabel.TextXAlignment = Enum.TextXAlignment.Right
        valLabel.Parent = frame
        local track = Instance.new("Frame")
        track.Size = UDim2.new(1, -28, 0, 6)
        track.Position = UDim2.new(0, 14, 0, 36)
        track.BackgroundColor3 = COLORS.sliderTrack
        track.BorderSizePixel = 0
        track.Parent = frame
        local tc = Instance.new("UICorner")
        tc.CornerRadius = UDim.new(1, 0)
        tc.Parent = track
        local initRatio = (default - minVal) / (maxVal - minVal)
        local fill = Instance.new("Frame")
        fill.Size = UDim2.new(initRatio, 0, 1, 0)
        fill.BackgroundColor3 = COLORS.sliderFill
        fill.BorderSizePixel = 0
        fill.Parent = track
        local fc = Instance.new("UICorner")
        fc.CornerRadius = UDim.new(1, 0)
        fc.Parent = fill
        local sKnob = Instance.new("Frame")
        sKnob.Size = UDim2.new(0, 16, 0, 16)
        sKnob.Position = UDim2.new(initRatio, 0, 0.5, 0)
        sKnob.AnchorPoint = Vector2.new(0.5, 0.5)
        sKnob.BackgroundColor3 = COLORS.sliderKnob
        sKnob.BorderSizePixel = 0
        sKnob.ZIndex = 2
        sKnob.Parent = track
        local skc = Instance.new("UICorner")
        skc.CornerRadius = UDim.new(1, 0)
        skc.Parent = sKnob
        local sks = Instance.new("UIStroke")
        sks.Color = COLORS.accent
        sks.Thickness = 2
        sks.Parent = sKnob
        local hitbox = Instance.new("TextButton")
        hitbox.Size = UDim2.new(1, 0, 0, 24)
        hitbox.Position = UDim2.new(0, 0, 0, 26)
        hitbox.BackgroundTransparency = 1
        hitbox.Text = ""
        hitbox.ZIndex = 3
        hitbox.Parent = frame
        local dragging = false
        local currentVal = default
        local function update(inputX)
            pcall(function()
                local absPos = track.AbsolutePosition.X
                local absSize = track.AbsoluteSize.X
                local rel = math.clamp((inputX - absPos) / absSize, 0, 1)
                local raw = minVal + (maxVal - minVal) * rel
                currentVal = math.floor(raw / step + 0.5) * step
                currentVal = math.clamp(currentVal, minVal, maxVal)
                local displayVal = currentVal
                if step < 1 then displayVal = math.floor(currentVal * 10 + 0.5) / 10 end
                local ratio = (currentVal - minVal) / (maxVal - minVal)
                fill.Size = UDim2.new(ratio, 0, 1, 0)
                sKnob.Position = UDim2.new(ratio, 0, 0.5, 0)
                valLabel.Text = tostring(displayVal)
                if callback then safeCall(callback, currentVal) end
            end)
        end
        trackConnection(hitbox.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                update(input.Position.X)
            end
        end))
        trackConnection(hitbox.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = false
            end
        end))
        trackConnection(_UIS.InputChanged:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                update(input.Position.X)
            end
        end))
        return {
            frame = frame,
            getValue = function() return currentVal end,
            setValue = function(val)
                currentVal = math.clamp(val, minVal, maxVal)
                local ratio = (currentVal - minVal) / (maxVal - minVal)
                pcall(function()
                    fill.Size = UDim2.new(ratio, 0, 1, 0)
                    sKnob.Position = UDim2.new(ratio, 0, 0.5, 0)
                    local displayVal = currentVal
                    if step < 1 then displayVal = math.floor(currentVal * 10 + 0.5) / 10 end
                    valLabel.Text = tostring(displayVal)
                end)
            end,
        }
    end

