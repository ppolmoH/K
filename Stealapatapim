        if x > MAX_PART_SIZE then x = MAX_PART_SIZE end
        if y > MAX_PART_SIZE then y = MAX_PART_SIZE end
        if z > MAX_PART_SIZE then z = MAX_PART_SIZE end
        return Vector3.new(x, y, z)
